PORT=3000
HOST=127.0.0.1
CONTROLLED_COMPOSE_PROJECT_NAME=git
# Absolute path to the Compose file in this repository's parent directory.
# COMPOSE_FILE=/absolute/path/to/git/docker-compose.yml
# WORKSPACE_DIR=/absolute/path/to/git
# WORKSPACE_HOST_PATH=/absolute/path/to/git
# Optional JSON service catalog. Leave blank to use the bundled local-infra services.
# CONTROL_CENTER_SERVICES=[{"id":"api","label":"API","compose":"api","ports":["8080"],"runtimeMode":"daemon"}]
CONTROL_CENTER_SERVICES=
TASK_DB_PATH=./data/control-center.sqlite
TRUST_CODER_PROXY=false
CODER_ACTOR_HEADER=x-coder-user
# Comma-separated origins for cross-origin API calls. Same-origin requests are always accepted.
# Add the public Coder/workspace URL here only when its frontend calls this API cross-origin.
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app

DATASTORE_EMULATOR_HOST=localhost:8085
DATASTORE_PROJECT_ID=local-project
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT_ID=local-project
SPANNER_INSTANCE_ID=local-instance
SPANNER_DATABASE_ID=local-database
KAFKA_UI_INTERNAL_URL=http://localhost:8080
KAFKA_UI_OPEN_URL=
REDASH_INTERNAL_URL=http://localhost:5000
REDASH_OPEN_URL=http://localhost:5000
