PORT=3000
HOST=127.0.0.1
CONTROLLED_COMPOSE_PROJECT_NAME=git
# Absolute path to the Compose file in this repository's parent directory.
# COMPOSE_FILE=/absolute/path/to/git/docker-compose.yml
# WORKSPACE_DIR=/absolute/path/to/git
# WORKSPACE_HOST_PATH=/absolute/path/to/git
# Optional JSON service catalog. Leave blank to use the bundled local-infra services.
# CONTROL_CENTER_SERVICES=[{"id":"api","label":"API","compose":"api","ports":["8080"],"runtimeMode":"daemon"}]
CONTROL_CENTER_SERVICES=
TASK_DB_PATH=./data/control-center.sqlite
TRUST_CODER_PROXY=false
CODER_ACTOR_HEADER=x-coder-user
# Comma-separated origins for cross-origin API calls. Same-origin requests are always accepted.
# Add the public Coder/workspace URL here only when its frontend calls this API cross-origin.
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app

DATASTORE_EMULATOR_HOST=localhost:8085
DATASTORE_PROJECT_ID=local-project
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT_ID=local-project
SPANNER_INSTANCE_ID=local-instance
SPANNER_DATABASE_ID=local-database
KAFKA_UI_INTERNAL_URL=http://localhost:8080
KAFKA_UI_OPEN_URL=
REDASH_INTERNAL_URL=http://localhost:5000
REDASH_OPEN_URL=http://localhost:5000
KEYCLOAK_INTERNAL_URL=http://localhost:8082
KEYCLOAK_OPEN_URL=http://localhost:8082/keycloak-embed/admin/master/console/
MAILHOG_INTERNAL_URL=http://localhost:8025
MAILHOG_OPEN_URL=http://localhost:8025/mailhog-embed/
BIGQUERY_API_ENDPOINT=http://localhost:9050
BIGQUERY_PROJECT_ID=local-project

# Jira connection defaults. The token is backend-only and is never stored in MySQL.
JIRA_TYPE=cloud
JIRA_BASE_URL=https://your-site.atlassian.net
# Optional override when the backend must use a different reachable URL.
JIRA_INTERNAL_URL=
JIRA_JQL=project = LOCAL ORDER BY updated DESC
JIRA_ALLOWED_PROJECTS=LOCAL
# JSON array: each field defines Jira id, displayed label, and optional nested value path.
d# JIRA_CUSTOM_FIELDS=[{"id":"customfield_10000","label":"Epic","role":"epic"},{"id":"customfield_10043","label":"Sprint","role":"sprint"},{"id":"customfield_10016","label":"Story points","path":"value"},{"id":"customfield_10042","label":"Team","path":"name"}]
JIRA_CUSTOM_FIELDS=[]
# JSON object: Jira assignee name -> display name in the UI. Unmapped names stay unchanged.
# JIRA_ASSIGNEE_DISPLAY_MAP={"A":"ANY"}
JIRA_ASSIGNEE_DISPLAY_MAP={}
JIRA_API_TOKEN=
# Jira Cloud account email; not required for Data Center bearer-token auth.
JIRA_EMAIL=
JIRA_REQUEST_TIMEOUT_MS=15000
JIRA_FIELD_OPTION_CACHE_TTL_MS=900000

# Confluence Data Center monitoring. PAT/webhook secret are backend-only.
CONFLUENCE_DEMO_MODE=true
CONFLUENCE_BASE_URL=https://confluence.example.com
# Optional URL reachable from the API container when different from the browser URL.
CONFLUENCE_INTERNAL_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_WEBHOOK_SECRET=
# Public Control Center origin used as the Confluence webhook callback target.
CONFLUENCE_APP_URL=http://localhost:3000
CONFLUENCE_REQUEST_TIMEOUT_MS=15000
CONFLUENCE_SYNC_TIMEZONE=Asia/Bangkok

# Required to unlock the Notes workspace. Leave blank to keep Notes disabled.
NOTES_PASSWORD=
