{
  "name": "local-infra-control-center",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @local-infra/api run dev",
    "dev:web": "npm --workspace @local-infra/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace @local-infra/api run build",
    "build:web": "npm --workspace @local-infra/web run build",
    "start": "npm --workspace @local-infra/api run start",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "npm --workspace @local-infra/api run typecheck",
    "typecheck:web": "npm --workspace @local-infra/web run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5"
  }
}
